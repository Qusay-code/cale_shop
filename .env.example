# Local development example. Copy to .env and never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=cale_shop
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Request parsing thresholds in bytes; image files are limited to 10 MiB.
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440

# Production HTTPS
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
TRUST_PROXY_SSL_HEADER=False
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Shared cache for multi-worker production rate limiting (optional locally).
# Example: redis://127.0.0.1:6379/1
REDIS_URL=

# Cloudflare Turnstile. Leave empty only for local DEBUG development.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Password-reset email. Console backend is used automatically in DEBUG.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=no-reply@example.com

# CORS remains same-origin unless trusted origins are explicitly listed.
CORS_ALLOWED_ORIGINS=
