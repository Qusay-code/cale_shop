# CALE Shop production example.
# Replace example.com and filesystem paths before deployment.
# Obtain the certificate with Certbot/Let's Encrypt; do not commit certificates or keys.

server {
    listen 80;
    server_name example.com www.example.com;

    # Allow multipart overhead while keeping total requests near the 10 MB
    # per-file limit enforced by Django.
    client_max_body_size 11m;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name example.com www.example.com;

    # Allow multipart overhead while keeping total requests near the 10 MB
    # per-file limit enforced by Django.
    client_max_body_size 11m;

    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Never expose directory contents.
    autoindex off;

    # Never serve hidden files such as .env, .git, or editor metadata.
    location ~ /\. {
        deny all;
        return 404;
    }

    location /static/ {
        alias /srv/cale-shop/staticfiles/;
        autoindex off;
    }

    location /media/ {
        alias /srv/cale-shop/media/;
        autoindex off;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_redirect off;
    }
}
